# Copy to .env.local for Next; pass DATABASE_URL to Prisma CLI explicitly. Never commit secrets.
DATABASE_URL=postgresql://laundry_app:local_development_only@localhost:5432/laundry_operations?schema=public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3002
# One-off CLI bootstrap only: existing invited and verified Supabase auth user UUID.
BOOTSTRAP_AUTH_USER_ID=
BOOTSTRAP_EMAIL=
BOOTSTRAP_DISPLAY_NAME=

# CLI-only identity provisioning; never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ACCESS_TOKEN=
PROVISION_USER_JSON=
# Explicit isolated database and test-only browser identities for acceptance.
TEST_DATABASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_DISPLAY_NAME=

# Loopback-only sign-in for isolated local Supabase and PostgreSQL test accounts.
OPERATIONS_TEST_AUTOFILL=false
TEST_AUTOFILL_ADMIN_EMAIL=
TEST_AUTOFILL_ADMIN_PASSWORD=
TEST_AUTOFILL_SUPERVISOR_EMAIL=
TEST_AUTOFILL_SUPERVISOR_PASSWORD=
TEST_AUTOFILL_DELIVERY_EXECUTIVE_EMAIL=
TEST_AUTOFILL_DELIVERY_EXECUTIVE_PASSWORD=

# Opt-in external staff invitation delivery (requires owner approval and service key).
STAFF_INVITES_ENABLED=false

# WhatsApp inbound is off by default. These values stay on the server.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional scoped supervisor profile UUID for enquiries without a unique branch match.
WHATSAPP_INBOX_SUPERVISOR_ID=
